+  if (GRUB_LONG_MAX > GRUB_INT_MAX)
     {
-      unsigned long num = ((long) UINT_MAX) << 2;
+      unsigned long num = ((long) GRUB_UINT_MAX) << 2;
       unsigned char der[20];
